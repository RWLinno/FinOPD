{"name": "CNTD_NetMF", "expr": "(COUNT($close > DELAY($close, 1) & $net_mf_vol > 0, 30) - COUNT($close < DELAY($close, 1) & $net_mf_vol < 0, 30)) / 30", "Information_Ratio_with_cost": 0.4876}
{"name": "HIGH_RET_VOL_20_15", "expr": "(COUNT($close > DELAY($close, 1) & ABS($return) > 0.015 & $volume > TS_MEDIAN($volume, 20), 20) - COUNT($close < DELAY($close, 1) & ABS($return) > 0.015 & $volume > TS_MEDIAN($volume, 20), 20)) / 20", "Information_Ratio_with_cost": 0.4786}
{"name": "ORDER_FLOW_VOL_TREND_90", "expr": "((COUNT($close > DELAY($close, 1), 90) - COUNT($close < DELAY($close, 1), 90)) / 90) * ($buy_lg_vol / $volume > 0.2) * (TS_MEAN($close, 50) < $close) * (ATR($high, $low, $close, 14) / $close > 0.02)", "Information_Ratio_with_cost": 1.3544}
{"name": "CNTD90_ATR_20", "expr": "((COUNT($close > DELAY($close,1),90) - COUNT($close < DELAY($close,1),90)) / 90) / ATR($high, $low, $close, 20)", "Information_Ratio_with_cost": 1.019}
{"name": "SUMP20_slope", "expr": "SUMIF($close - DELAY($close, 1), 20, SLOPE($close, 20) > 0) / (TS_SUM(ABS($close - DELAY($close, 1)), 20) + 1e-12)", "Information_Ratio_with_cost": 0.7538}
{"name": "RSI_14_NetFlow_Momentum_5_TrendStrength_IndustryNeutral", "expr": "INDUSTRY_NEUTRALIZE( ($net_mf_vol > 0) & (DELTA($net_mf_vol, 5) > 0) & (SLOPE(RSI($close, 14), 5) > 0) ? RSI($close, 14) : 0, $industry )", "Information_Ratio_with_cost": 1.3529}
{"name": "VOL_SUMP20_SMA_VWAP", "expr": "(SUMIF(($close - DELAY($close,1)) * $volume, 20, $close > DELAY($close,1)) - TS_MEAN(($close - DELAY($close,1)) * $volume, 20)) / (TS_SUM(ABS(($close - DELAY($close,1)) * $volume), 20) + 1e-12) / (TS_MEAN($close, 20) / $close)", "Information_Ratio_with_cost": 1.1855}
{"name": "SUMP30_ORDER_FLOW_20MA", "expr": "SUMIF($close - DELAY($close,1), 30, ($close > DELAY($close,1)) & ($net_mf_vol > TS_MEAN($net_mf_vol, 20))) / (TS_SUM(ABS($close - DELAY($close,1)), 30) + 1e-12)", "Information_Ratio_with_cost": 0.8964}
{"name": "ZIGZAG_BOTTOM_MAD_0.2_90", "expr": "SUMIF(($close - ZIGZAG_BOTTOM($close, 1, 0.2)) > 0, 90, $close - ZIGZAG_BOTTOM($close, 1, 0.2)) / (TS_MAD($close - ZIGZAG_BOTTOM($close, 1, 0.2), 90) + 1e-12)", "Information_Ratio_with_cost": 0.7785}
{"name": "RSI_7_OVERSOLD_MACD_12_26_DROP_RATIO_5D", "expr": "SUMIF(DELAY($close,1) - $close, 5, ($close < DELAY($close,1)) & (MACD($close,12,26) < 0) & (RSI($close,7) < 20) & ($volume > TS_MEAN($volume,5))) / (TS_SUM(ABS($close - DELAY($close,1)), 5) + 1e-12)", "Information_Ratio_with_cost": 1.451}
{"name": "HIGH_DECLINE_OVER_SMA_WITH_RSI", "expr": "SUMIF((DELAY($high,1) - $high), 10, $high < DELAY($high,1) & RSI($high, 14) < 30) / (TS_MEAN(ABS($high - DELAY($high,1)), 10) + 1e-12)", "Information_Ratio_with_cost": 1.1477}
{"name": "UPWARD_RATIO_20_RSI_28", "expr": "SUMIF($close - DELAY($close, 1), 20, $close > DELAY($close, 1)) / (TS_SUM(ABS($close - DELAY($close, 1)), 20) + 1e-12) * RSI($close, 28)", "Information_Ratio_with_cost": 0.8138}
{"name": "SUMN60", "expr": "SUMIF(DELAY($close,1) - $close, 60, $close < DELAY($close,1)) / (TS_SUM(ABS($close - DELAY($close,1)), 60) + 1e-12)", "Information_Ratio_with_cost": 0.9572}
{"name": "SUMN60_VOLUME", "expr": "SUMIF((DELAY($close,1) - $close) * $volume, 60, $close < DELAY($close,1)) / (TS_SUM(ABS($close - DELAY($close,1)) * $volume, 60) + 1e-12)", "Information_Ratio_with_cost": 0.9854}
{"name": "ORDER_FLOW_RSI_MACD_HIGH_VOL", "expr": "(SUMIF($buy_lg_vol, 5, $close > DELAY($close,1)) - SUMIF($sell_lg_vol, 5, $close < DELAY($close,1))) * (RSI($close, 14) < 50) * (MACD($close, 12, 26) > 0) * ($volume > PERCENTILE($volume, 0.9)) / (ATR($high, $low, $close, 14) * (TS_SUM(ABS($close - DELAY($close,1)), 5) + 1e-12) + 1e-12)", "Information_Ratio_with_cost": 1.7752}
{"name": "SUMD_RSI_VOLUME_SMA_VOLUME_SLOPE", "expr": "(SUMIF($close - DELAY($close,1), 10, ($close > DELAY($close,1)) & (RSI($close, 14) > 50) & ($volume > 2 * TS_MEAN($volume, 20)) & ($close > TS_MEAN($close, 20)) & (DELTA($volume, 1) > 0)) - SUMIF(DELAY($close,1) - $close, 10, ($close < DELAY($close,1)) & (RSI($close, 14) > 50) & ($volume > 2 * TS_MEAN($volume, 20)) & ($close > TS_MEAN($close, 20)) & (DELTA($volume, 1) > 0))) / (TS_SUM(ABS($close - DELAY($close,1)), 10) + 1e-12)", "Information_Ratio_with_cost": 0.9396}
{"name": "VOL_MOM_20", "expr": "(SUMIF(($close - DELAY($close, 1)) * $volume, 20, $close > DELAY($close, 1)) - SUMIF((DELAY($close, 1) - $close) * $volume, 20, $close < DELAY($close, 1))) / (TS_SUM(ABS($close - DELAY($close, 1)) * $volume, 20) + 1e-12)", "Information_Ratio_with_cost": 1.0235}
{"name": "SUMD30_SLOPE", "expr": "(SUMIF($close - DELAY($close,1), 30, ($close > DELAY($close,1)) & (SLOPE($close, 60) > 0)) - SUMIF(DELAY($close,1) - $close, 30, ($close < DELAY($close,1)) & (SLOPE($close, 60) < 0))) / (TS_SUM(ABS($close - DELAY($close,1)), 30) + 1e-12)", "Information_Ratio_with_cost": 0.66}
{"name": "ZSCORE_THRESHOLD_SUMD60", "expr": "((SUMIF($close-DELAY($close,1),60,$close>DELAY($close,1)) - SUMIF(DELAY($close,1)-$close,60,$close<DELAY($close,1))) / (TS_SUM(ABS($close-DELAY($close,1)),60)+1e-12)) * (($close - TS_MEAN($close, 20)) / TS_STD($close, 20) > 0.5 ? 1 : -1)", "Information_Ratio_with_cost": 1.0964}
{"name": "BUY_LG_MEDIAN_ZSCORE", "expr": "TS_ZSCORE(TS_MEDIAN($buy_lg_vol, 5), 10) / (TS_MEAN($volume, 10) + 1e-12)", "Information_Ratio_with_cost": 1.8922}
{"name": "VOLUME_TREND_SMALL_RATIO", "expr": "ZSCORE((TS_MEAN($buy_sm_vol, 10) / (TS_MEAN($buy_md_vol, 10) + 1e-12)) * (TS_MEAN($volume, 20) / TS_MEAN($volume, 10) - 1))", "Information_Ratio_with_cost": 0.4673}
{"name": "VOL_STD_DIFF", "expr": "(TS_STD($volume, 10) - TS_STD($volume, 30)) / (TS_STD($volume, 20) + 1e-12)", "Information_Ratio_with_cost": 0.9369}
{"name": "ORDER_FLOW_RANK_60", "expr": "RANK(($buy_lg_vol - $sell_lg_vol) / (TS_MEAN($buy_lg_vol - $sell_lg_vol, 60) + 1e-12))", "Information_Ratio_with_cost": 0.5869}
{"name": "VMA60_STD_MED", "expr": "TS_MEDIAN($volume,60) / (TS_STD($volume,60) + 1e-12)", "Information_Ratio_with_cost": 1.0094}
{"name": "VOL_RETURN_30", "expr": "TS_STD($volume, 30) * $return", "Information_Ratio_with_cost": 0.9909}
{"name": "VSTD_ZSCORE_15", "expr": "INDUSTRY_NEUTRALIZE((TS_STD($volume,10)/($volume + 1e-12)) * TS_ZSCORE($close,15), $industry)", "Information_Ratio_with_cost": 1.3107}
{"name": "VSTD60_90", "expr": "TS_STD($volume, 90) / ($volume + 1e-12)", "Information_Ratio_with_cost": 0.6985}
{"name": "VSTD90", "expr": "TS_STD($volume, 90) / ($volume + 1e-12)", "Information_Ratio_with_cost": 0.6985}
{"name": "VOLATILITY_RATIO_90_30_ske_w", "expr": "(TS_STD($volume,90)/TS_STD($volume,30) - 1) * ABS(TS_SKEW($volume,30)) / ($volume + 1e-12)", "Information_Ratio_with_cost": 1.2292}
{"name": "VOL_MOM_20", "expr": "(TS_STD(ABS($close/DELAY($close,1)-1)*$volume,5) * TS_MEAN($return,20)) / (TS_MEAN(ABS($close/DELAY($close,1)-1)*$volume,5) + 1e-12)", "Information_Ratio_with_cost": 1.0202}
{"name": "ATR_Momentum_Industry", "expr": "INDUSTRY_NEUTRALIZE((ATR($high, $low, $close, 10) / $close) * (($close / DELAY($close, 1) - 1)), $industry)", "Information_Ratio_with_cost": 1.6714}
{"name": "ORDER_FLOW_MED_MOMENTUM_20_Zscore", "expr": "TS_ZSCORE( ( ($close / DELAY($close,1) - 1) * ( ($buy_md_vol - $sell_md_vol) - DELAY($buy_md_vol - $sell_md_vol, 1) ) ) / $volume, 20 )", "Information_Ratio_with_cost": 1.185}
{"name": "WVMA_NO_ABS_MEDIAN", "expr": "TS_STD(($close/DELAY($close,1)-1)*$volume,30) / (TS_MEDIAN(($close/DELAY($close,1)-1)*$volume,30) + 1e-12)", "Information_Ratio_with_cost": 0.7978}
{"name": "ATR_ZIGZAG_LOW", "expr": "ATR($high, $low, $close, 60) * (ZIGZAG_BOTTOM_DAYS($close, 1) > 20) / $close", "Information_Ratio_with_cost": 2.2349}
{"name": "VSUMP10", "expr": "SUMIF($volume, 10, $volume > DELAY($volume, 1)) / (TS_SUM(ABS($volume - DELAY($volume, 1)), 10) + 1e-12)", "Information_Ratio_with_cost": 0.7496}
{"name": "VSUMP_NETFLOW_OUTPERFORM_ZSCORE_LONG", "expr": "SUMIF(($net_mf_vol > DELAY($net_mf_vol, 1)) & ($return > $bench_return) & (TS_ZSCORE($net_mf_vol, 30) > 0), 10, $net_mf_vol - DELAY($net_mf_vol, 1)) / (TS_SUM(ABS($net_mf_vol - DELAY($net_mf_vol, 1)), 10) + 1e-12)", "Information_Ratio_with_cost": 1.4004}
{"name": "VSUMP70_POS_RETURN_CORR", "expr": "SUMIF($volume - DELAY($volume,1), 70, ($volume > DELAY($volume,1)) & ($return > 0) & (TS_CORR($volume - DELAY($volume,1), $return, 70) > 0.5)) / (TS_SUM(ABS($volume - DELAY($volume,1)), 70) + 1e-12)", "Information_Ratio_with_cost": 0.5848}
{"name": "VSUMP90", "expr": "SUMIF($volume > DELAY($volume,1), 90, $volume) / (TS_SUM(ABS($volume - DELAY($volume,1)), 90) + 1e-12)", "Information_Ratio_with_cost": 0.555}
{"name": "VSUMP60_PRICE_UP_MACD_POS", "expr": "SUMIF(($volume - DELAY($volume, 1)) > 0 & ($close > DELAY($close, 1)) & (MACD($close, 12, 26) > 0), 60, $volume - DELAY($volume, 1)) / (TS_SUM(ABS($volume - DELAY($volume, 1)), 60) + 1e-12)", "Information_Ratio_with_cost": 0.7952}
{"name": "VSUMN5_MACD_VolSlope15", "expr": "SUMIF(DELAY($volume,1) - $volume, 5, ($volume < DELAY($volume,1)) & ($return < 0) & (SLOPE($volume, 15) < 0) & (MACD($close, 12, 24) < 0)) / (TS_SUM(ABS($volume - DELAY($volume,1)), 5) + 1e-12)", "Information_Ratio_with_cost": 1.5769}
{"name": "VSUMN10_MEDIAN_DROP_AVG", "expr": "TS_MEDIAN(DELAY($volume,1) - $volume, 10) / (TS_MEAN(ABS($volume - DELAY($volume,1)), 10) + 1e-12)", "Information_Ratio_with_cost": 1.1097}
{"name": "VOL_DECREASE_RATIO_10", "expr": "SUMIF(DELAY($volume,1) - $volume, 10, $volume < DELAY($volume,1)) / (TS_SUM(ABS($volume - DELAY($volume,1)), 10) + 1e-12)", "Information_Ratio_with_cost": 0.4787}
{"name": "VSUMN30_NEG_VOLUME_ZSCORE", "expr": "TS_ZSCORE(DELAY($volume, 1) - $volume, 30) * ($volume < DELAY($volume, 1)) / (TS_SUM(ABS($volume - DELAY($volume, 1)), 30) + 1e-12) / ATR($high, $low, $close, 14)", "Information_Ratio_with_cost": 1.811}
{"name": "VOL_DROP_RSI_30_MACD_BULL", "expr": "SUMIF(DELAY($volume,1) - $volume, 60, $volume < DELAY($volume,1) & RSI($close,14) < 30 & $close < TS_MEAN($close,50) & MACD($close,12,26) > 0) / (TS_SUM(ABS($volume - DELAY($volume,1)),60) + 1e-12)", "Information_Ratio_with_cost": 0.2827}
{"name": "VSUMD_VOL_ZSCORE_MACD", "expr": "(SUMIF($volume - DELAY($volume,1), 5, $volume > DELAY($volume,1) & TS_ZSCORE($volume, 20) > 1 & MACD($close, 12, 26) > 0) - SUMIF(DELAY($volume,1) - $volume, 5, $volume < DELAY($volume,1) & TS_ZSCORE($volume, 20) < -1 & MACD($close, 12, 26) < 0)) / (TS_SUM(ABS($volume - DELAY($volume,1)), 5) + 1e-12)", "Information_Ratio_with_cost": 0.6386}
{"name": "VSUMD10_ZIGZAG_RANGE_30", "expr": "(ZIGZAG_HIGHEST_TOP($volume, 30) - ZIGZAG_LOWEST_BOTTOM($volume, 30)) / (TS_STD($volume, 30) + 1e-12)", "Information_Ratio_with_cost": 1.2371}
{"name": "VSUMD_ORDER_FLOW_INDUSTRY_NEUTRAL", "expr": "INDUSTRY_NEUTRALIZE((SUMIF($net_mf_vol - DELAY($net_mf_vol, 1), 15, $net_mf_vol > DELAY($net_mf_vol, 1)) - SUMIF(DELAY($net_mf_vol, 1) - $net_mf_vol, 15, $net_mf_vol < DELAY($net_mf_vol, 1))) / (TS_SUM(ABS($net_mf_vol - DELAY($net_mf_vol, 1)), 15) + 1e-12), $industry)", "Information_Ratio_with_cost": 1.6427}
{"name": "VSUMD30_PRICE", "expr": "(SUMIF(($volume > DELAY($volume, 1)) & ($close > DELAY($close, 1)), 30, $volume - DELAY($volume, 1)) - SUMIF(($volume < DELAY($volume, 1)) & ($close < DELAY($close, 1)), 30, DELAY($volume, 1) - $volume)) / (TS_SUM(ABS($volume - DELAY($volume, 1)), 30) + 1e-12)", "Information_Ratio_with_cost": 0.7136}
{"name": "VOL_PRICE_RATIO_ZIGZAG_BOTTOM_2", "expr": "((SUMIF($volume - DELAY($volume,1), 60, $volume > DELAY($volume,1)) - SUMIF(DELAY($volume,1) - $volume, 60, $volume < DELAY($volume,1))) / (TS_SUM(ABS($volume - DELAY($volume,1)), 60) + 1e-12)) / ((SUMIF($return - DELAY($return,1), 60, $return > DELAY($return,1)) - SUMIF(DELAY($return,1) - $return, 60, $return < DELAY($return,1))) / (TS_SUM(ABS($return - DELAY($return,1)), 60) + 1e-12) + 1e-12) * (1 + ZIGZAG_BOTTOM_DAYS($close, 2) / 100)", "Information_Ratio_with_cost": 0.7929}
