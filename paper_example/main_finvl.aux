\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Architecture of \textsc  {FinOPD}. The Visual-Geometric Encoder extracts structured ChartGeometry from candlestick charts. The Factor Router selects 15 from 160 candidates via Gumbel top-$k$. Five specialist agents collaborate through gated shared memory. The dual-track self-evolution loop (bottom) updates LoRA parameters via on-policy self-distillation with hindsight PnL and Shapley credit (left track) and consolidates winning patterns into a belief store (right track).\relax }}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:architecture}{{2}{4}{Architecture of \textsc {FinOPD}. The Visual-Geometric Encoder extracts structured ChartGeometry from candlestick charts. The Factor Router selects 15 from 160 candidates via Gumbel top-$k$. Five specialist agents collaborate through gated shared memory. The dual-track self-evolution loop (bottom) updates LoRA parameters via on-policy self-distillation with hindsight PnL and Shapley credit (left track) and consolidates winning patterns into a belief store (right track).\relax }{figure.caption.7}{}}
